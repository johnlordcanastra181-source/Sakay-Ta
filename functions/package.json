{
  "name": "sakay-ta-functions",
  "description": "Firebase Cloud Functions for Sakay Ta - Secure Admin Account Management using Firebase Admin SDK",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "create-admin": "node create-admin-cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0"
  },
  "private": true
}
